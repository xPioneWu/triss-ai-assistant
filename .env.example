# Triss Ortam Değişkenleri
# Bu dosyayı kimseyle paylaşmayın! Git'e eklemeyin!

# ── ZORUNLU ─────────────────────────────────────────
# Google Gemini API Anahtarı
# Nereden alınır: aistudio.google.com > Get API key
GEMINI_API_KEY=BURAYA_GEMINI_ANAHTARINIZI_YAZIN

# ── HAVA DURUMU (isteğe bağlı) ──────────────────────
# OpenWeatherMap API Anahtarı (ücretsiz)
# Nereden alınır: openweathermap.org/api
OPENWEATHER_API_KEY=BURAYA_WEATHER_ANAHTARINI_YAZIN

# ── SPOTİFY MÜZİK (isteğe bağlı) ───────────────────
# Nereden alınır: developer.spotify.com/dashboard
# Redirect URI olarak eklemeniz gereken: http://localhost:8888/callback
SPOTIFY_CLIENT_ID=BURAYA_SPOTIFY_CLIENT_ID_YAZIN
SPOTIFY_CLIENT_SECRET=BURAYA_SPOTIFY_SECRET_YAZIN
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

